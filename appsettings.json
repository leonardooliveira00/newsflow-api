{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "RequireUniqueEmail": true,
    "RequireConfirmedEmail": true,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "AllowedForNewUsers": true
  },
  "Authentication": {
    "Cookie": {
      "Name": "newsflow_auth",
      "HttpOnly": true,
      "SecurePolicy": "SameAsRequest",
      "SameSite": "Lax",
      "ExpireHours": 8,
      "SlidingExpiration": true
    }
  }
}